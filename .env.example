# Copiar a .env y ajustar. Nunca subir .env al repositorio.
POSTGRES_DB=envdoctor
POSTGRES_USER=envdoctor
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_PORT=5432

API_PORT=8080
FRONTEND_PORT=3000
OLLAMA_PORT=11434

# Modelo local para Semantic Kernel
OLLAMA_MODEL=qwen2.5:3b

# Feature flag: búsqueda vectorial con pgvector (opcional)
FEATURES__VECTORSEARCH=false
